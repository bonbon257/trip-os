{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60,
      "includeFiles": [
        "node_modules/.prisma/**",
        "node_modules/@prisma/**"
      ]
    }
  }
}
