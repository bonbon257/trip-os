# ─────────────────────────────────────────────────────────────
# Trip OS 后端 · 复制为 .env 后填值：cp .env.example .env
# 密钥绝不能进 git（.gitignore 已拦）
# ─────────────────────────────────────────────────────────────

# 监听端口
PORT=8787

# 允许的 CORS 来源（多个用逗号）
CORS_ORIGINS=http://localhost:5173

# JWT 签名密钥（生产环境用 openssl rand -base64 32 生成）
JWT_SECRET=dev-secret-please-change-in-production

# 数据库（SQLite 起步，迁 Postgres 时改 URL 即可）
DATABASE_URL=file:./prisma/dev.db

# 高德地图 · Web 服务 Key（后端用：地理编码、路径规划）
AMAP_WEB_KEY=

# 高德地图 · JS API key（给浏览器地图组件用）
AMAP_JS_KEY=

# 高德地图 · 安全密钥（仅服务端持有，绝不下发到浏览器）
AMAP_SECURITY_KEY=

# ─────────────────────────────────────────────────────────────
# LLM（同前端 .env 变量名一致，方便两边复用）
# ─────────────────────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 超时毫秒
AI_TIMEOUT_MS=20000

# ─────────────────────────────────────────────────────────────
# 高德高德应用配置（控制台创建 Key 时勾的服务平台）
#   · Web 端 (JS API)    → 给浏览器地图组件用，配在前端 .env
#   · Web 服务            → 给后端 REST API 用，配本文件 AMAP_WEB_KEY
#   · iOS 平台           → 给 iOS App 用，App 内自带
#   · 微信小程序         → 给小程序用，App 内自带
# ─────────────────────────────────────────────────────────────