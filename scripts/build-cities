    "丹东市": dict(tags=["nature", "photo", "niche", "food"], cost=1, days=(2, 3), intensity="medium", season=[5, 6, 9, 10], highlights=["鸭绿江", "绿江村", "凤凰山", "河口断桥"]),
    "本溪市": dict(tags=["nature", "photo", "niche", "outdoor"], cost=1, days=(2, 3), intensity="medium", season=[9, 10, 7, 8], highlights=["关门山红叶", "本溪水洞", "五女山", "汤沟"]),
    "盘锦市": dict(tags=["nature", "photo", "niche", "food"], cost=1, days=(2, 3), intensity="low", season=[5, 6, 9, 10], highlights=["红海滩", "芦苇荡", "鼎翔", "辽河"]),
}

DEFAULT_PROFILE = dict(tags=["citywalk", "food", "photo"], cost=1, season=[4, 5, 9, 10], region="其他")

# 消费档 → 每日花费区间（元/人/天，不含往返大交通）
COST_RANGE = {
    1: (260, 480),
    2: (420, 680),
    3: (680, 1080),
}

# 强度 → 建议天数
def pick_days(intensity: str, is_capital: bool) -> tuple:
    if is_capital:
        return (3, 5) if intensity != "high" else (4, 6)
    return (2, 4) if intensity != "high" else (3, 5)


def strip_suffix(name: str) -> str:
    """洛阳市 → 洛阳；大理白族自治州 → 大理；湘西土家族苗族自治州 → 湘西"""
    for suf in ("特别行政区", "维吾尔自治区", "壮族自治区", "回族自治区", "土家族苗族自治州",
                "藏族羌族自治州", "哈萨克自治州", "苗族自治州", "布依族苗族自治州",
                "朝鲜族自治州", "彝族自治州", "白族自治州", "傣族自治州", "蒙古族自治州",
                "哈尼族彝族自治州", "傈僳族自治州", "藏族自治州", "回族自治州",
                "自治州", "地区", "市", "县", "盟"):
        if name.endswith(suf) and len(name) > len(suf):
            return name[: -len(suf)]
    return name


def province_of(prov_name: str) -> dict:
    key = prov_name.replace("省", "").replace("市", "").replace("自治区", "").replace("特别行政区", "")
    for k, v in PROVINCE_PROFILE.items():
        if k in key or key in k:
            return v
    return DEFAULT_PROFILE


def build():
    if "--fetch" in sys.argv or not CACHE.exists():
        print("从高德拉行政区划…")
        url = f"{AMAP_DISTRICT}?key={AMAP_KEY}&keywords=中国&subdistrict=2&output=JSON"
        with urllib.request.urlopen(url, timeout=30) as r:
            data = json.load(r)
        CACHE.write_text(json.dumps(data, ensure_ascii=False))
        print(f"  缓存到 {CACHE}")
    else:
        data = json.loads(CACHE.read_text())

    if data.get("status") != "1":
        print("高德返回错误:", data.get("info"))
        return 1

    provinces = data["districts"][0]["districts"]
    rows = []
    seen = set()

    for p in provinces:
        pname = p["name"]
        prof = province_of(pname)
        for c in p.get("districts", []):
            if c.get("level") != "city":
                continue
            full = c["name"]
            short = strip_suffix(full)
            if not short or short in seen:
                continue
            seen.add(short)

            center = (c.get("center") or "").split(",")
            lng = float(center[0]) if len(center) == 2 and center[0] else 0.0
            lat = float(center[1]) if len(center) == 2 and center[1] else 0.0

            cur = CURATED.get(full) or CURATED.get(short + "市")
            is_capital = short in ("北京", "上海", "天津", "重庆", "广州", "成都", "杭州", "南京",
                                   "武汉", "西安", "长沙", "郑州", "济南", "沈阳", "长春",
                                   "哈尔滨", "石家庄", "太原", "呼和浩特", "兰州", "西宁",
                                   "银川", "乌鲁木齐", "拉萨", "昆明", "贵阳", "南宁", "海口",
                                   "福州", "南昌", "合肥")

            if cur:
                tags = cur["tags"]
                cost = cur["cost"]
                season = cur["season"]
                days = cur["days"]
                intensity = cur["intensity"]
                highlights = cur["highlights"]
                curated = True
            else:
                # 规则生成的城市只留 3 个核心标签。
                # 给太多会让「什么都能沾一点」的普通地级市在匹配时占便宜。
                tags = prof["tags"][:3]
                cost = prof["cost"]
                season = prof["season"]
                # 自然/户外为主的城市强度高一点，城市漫游为主则低
                intensity = "medium" if ("outdoor" in tags or "nature" in tags) else "low"
                days = pick_days(intensity, is_capital)
                highlights = []
                curated = False

            low, high = COST_RANGE[cost]
            # 旅游吸引力：精修 1.0 / 省会 0.8 / 普通地级市 0.5
            # 用于让用户偏好「小众探索」时能看到冷门目的地，
            # 默认则优先推荐更有内容的目的地。
            appeal = 1.0 if curated else (0.8 if is_capital else 0.5)
            rows.append(dict(
                appeal=appeal,
                id="cn-" + (c.get("adcode") or short),
                name=short,
                fullName=full,
                province=pname,
                region=prof["region"],
                lat=round(lat, 4),
                lng=round(lng, 4),
                adcode=c.get("adcode") or "",
                tags=tags,
                cost=cost,
                dailyLow=low,
                dailyHigh=high,
                idealMin=days[0],
                idealMax=days[1],
                intensity=intensity,
                season=season,
                highlights=highlights,
                curated=curated,
                isCapital=is_capital,
            ))

    rows.sort(key=lambda r: (not r["curated"], not r["isCapital"], r["name"]))

    # ── 生成 TS ──
    def ts(v):
        if isinstance(v, bool):
            return "true" if v else "false"
        if isinstance(v, (int, float)):
            return str(v)
        if isinstance(v, list):
            return "[" + ", ".join(ts(x) for x in v) + "]"
        s = str(v).replace("\\", "\\\\").replace("'", "\\'")
        return "'" + s + "'"

    lines = [
        "// 本文件由 scripts/build-cities.py 自动生成，请勿手工编辑",
        "// 数据来源：高德开放平台行政区划 API（全量地级市）",
        f"// 共 {len(rows)} 个城市 · 生成时间见 git 提交记录",
        "",
        "export interface CnCity {",
        "  id: string;",
        "  name: string;",
        "  fullName: string;",
        "  province: string;",
        "  region: string;",
        "  lat: number;",
        "  lng: number;",
        "  adcode: string;",
        "  tags: string[];",
        "  cost: 1 | 2 | 3;",
        "  dailyLow: number;",
        "  dailyHigh: number;",
        "  idealMin: number;",
        "  idealMax: number;",
        "  intensity: 'low' | 'medium' | 'high';",
        "  season: number[];",
        "  highlights: string[];",
        "  curated: boolean;",
        "  isCapital: boolean;",
        "  /** 旅游吸引力 0.5(普通地级市) ~ 1.0(精修目的地) */",
        "  appeal: number;",
        "}",
        "",
        "export const CN_CITIES: CnCity[] = [",
    ]
    for r in rows:
        fields = [
            f"id: {ts(r['id'])}", f"name: {ts(r['name'])}", f"fullName: {ts(r['fullName'])}",
            f"province: {ts(r['province'])}", f"region: {ts(r['region'])}",
            f"lat: {ts(r['lat'])}", f"lng: {ts(r['lng'])}", f"adcode: {ts(r['adcode'])}",
            f"tags: {ts(r['tags'])}", f"cost: {ts(r['cost'])}",
            f"dailyLow: {ts(r['dailyLow'])}", f"dailyHigh: {ts(r['dailyHigh'])}",
            f"idealMin: {ts(r['idealMin'])}", f"idealMax: {ts(r['idealMax'])}",
            f"intensity: {ts(r['intensity'])}", f"season: {ts(r['season'])}",
            f"highlights: {ts(r['highlights'])}", f"curated: {ts(r['curated'])}",
            f"isCapital: {ts(r['isCapital'])}", f"appeal: {ts(r['appeal'])}",
        ]
        lines.append("  { " + ", ".join(fields) + " },")
    lines.append("];")
    lines.append("")
    lines.append("export const CN_CITY_COUNT = CN_CITIES.length;")
    lines.append("")
    lines.append("/** 按名称索引，供详情页直接查 */")
    lines.append("export const cnCityById = (id: string) => CN_CITIES.find((c) => c.id === id);")
    lines.append("")

    OUT.write_text("\n".join(lines), encoding="utf-8")

    curated_count = sum(1 for r in rows if r["curated"])
    print(f"生成 {OUT.relative_to(ROOT)}")
    print(f"  城市总数 {len(rows)}")
    print(f"  精修城市 {curated_count} · 规则生成 {len(rows) - curated_count}")
    print(f"  文件大小 {OUT.stat().st_size / 1024:.0f} KB")
    return 0


if __name__ == "__main__":
    sys.exit(build())