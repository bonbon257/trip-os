#!/usr/bin/env python3
"""
从高德行政区划数据生成国内城市画像库
────────────────────────────────────────────────────────────
用法：
  python3 scripts/build-cities.py             # 用缓存的 amap-cities.json
  python3 scripts/build-cities.py --fetch     # 重新从高德拉

产出：src/data/cities-cn.ts

设计原则：
  1. 城市名单来自高德（权威、全量、含经纬度），不是手写
  2. 标签用「省份规则 + 精选城市精修」两层生成，保证每个城市都有画像
  3. 预留 LLM 精修接口（scripts/enrich-cities.py），拿到模型 key 后可批量精修
  4. 运行时推荐仍走结构化评分，不把推荐交给模型 —— 保持可解释、可复现
"""
import json
import pathlib
import re
import sys
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
