node_modules
dist
*.tsbuildinfo

# 密钥：API key 只放在这里，绝不能带 VITE_ 前缀（那会打进前端 bundle）
.env
.env.local
.env.*.local
!.env.example

# 运行时通过设置页写入的持久化配置（含密钥，不可提交）
server/.runtime-config.json
.runtime-config.json

.DS_Store
.vite

# 常驻开发服务的 pid 文件
.dev.pid
.dev.pid.*

# Vite 构建时产生的临时配置缓存
vite.config.ts.timestamp-*.mjs

# 日志
*.log

# 本地 SQLite 开发库（运行时数据，不入库）
server/prisma/prisma/*.db
server/prisma/prisma/*.db-journal

# API 函数（Vercel 用）：由 esbuild 预打包成 api/*.mjs。
# 注意：api/*.mjs 必须入库！Vercel 在 build 之前就校验 functions glob，
# 那时 .mjs 需已存在；build 阶段会重新生成（幂等）。源码在 api-src/，不在 api/。
# （dist-server/ 才是真正不入库的运行期产物）
dist-server/

# 常驻 Node 服务打包产物（scripts/bundle-server.mjs），运行期产物不入库
